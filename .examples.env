# Template for .env - copy to .env and fill in real values.
# Per CLAUDE.md: only the user edits .env directly. If a new credential/
# config value is ever needed, this file gets a new placeholder entry and
# the user is told - .env itself is never written to by the assistant
# except when explicitly asked to, as happened once on 2026-09-12.

# Rithmic (or other broker) account connected in MotiveWave.
MOTIVEWAVE_RITHMIC_ACCOUNT_ID=<your-rithmic-account-id>
MOTIVEWAVE_RITHMIC_USERNAME=<your-rithmic-username>
MOTIVEWAVE_RITHMIC_BROKER=<your-broker-or-FCM-name>

# Whether this account is real capital or a genuine demo/paper account.
# MUST be confirmed explicitly by the user - never inferred from the
# account name (a "TEST" suffix does not mean demo; see findings.md).
MOTIVEWAVE_RITHMIC_ACCOUNT_STATUS=<real_capital|demo>

# Instrument(s) used for testing.
MOTIVEWAVE_TRADED_INSTRUMENT=<exchange-symbol, e.g. GCZ6.COMEX.RITHMIC>
MOTIVEWAVE_TRADED_INSTRUMENT_CONTINUOUS=<continuous symbol, e.g. @GC>

# Any other data connections configured in this MotiveWave install.
MOTIVEWAVE_CQG_CONFIGURED=<true|false>
